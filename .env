# -- Base 
DISTRIBUTION=debian
SUITE=trixie-slim
DIGEST=sha256:020c0d20b9880058cbe785a9db107156c3c75c2ac944a6aa7ab59f2add76a7bd

# -- User
USER_NAME=monke
DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
USER_UID=$(id -u)

# -- Neovim (BIN)
INSTALL_NEOVIM=true
NEOVIM_VERSION=v0.12.4
TREE_SITTER_CLI=0.26.11

# -- Docker (GPG)
INSTALL_DOCKER=true
DOCKER_CE_VERSION="5:29.6.2-1~debian.13~trixie"
DOCKER_CE_CLI_VERSION="5:29.6.2-1~debian.13~trixie"
CONTAINERD_VERSION="2.2.6-1~debian.13~trixie"
DOCKER_BUILDX_VERSION="0.35.0-1~debian.13~trixie"
DOCKER_COMPOSE_VERSION="5.3.1-1~debian.13~trixie"

# -- K9S (BIN)
INSTALL_K9S=true
K9S_VERSION=v0.51.0

# -- Helm (GPG)
INSTALL_HELM=true
HELM_VERSION=4.2.3-1

# -- Kubectl (GPG)
INSTALL_KUBECTL=true
KUBECTL_VERSION=1.36.3-1.1

# -- Terraform (GPG)
INSTALL_TERRAFORM=true
TERRAFORM_VERSION=1.15.8-1

# -- AzureCLI (GPG)
INSTALL_AZURE_CLI=true
AZURE_CLI_SUITE=bullseye
AZURE_CLI_VERSION=2.74.0-1

# -- Node.js (GPG)
INSTALL_NODE_JS=true
NODE_JS_VERSION=22.23.1-1nodesource1
NODE_JS_MAJOR=22

# -- Liqiudprompt 
LIQUIDPROMPT_THEME=powerline
