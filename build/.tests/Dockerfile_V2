# =============================================================================
# : Config
# =============================================================================

# -----------------------------------------------
# Config: Groups
# -----------------------------------------------

ARG \
    TOOLBOX_SHARED_GID=29999

ENV \
    TOOLBOX_SHARED_GID=${TOOLBOX_SHARED_GID}

RUN \
    echo "**** Config: User & Groups  ****" \
        && groupadd \
            --gid "${TOOLBOX_SHARED_GID}" \
            toolbox-shared

# -----------------------------------------------
# Config: Base
# -----------------------------------------------

ENV \
    SHELL=/bin/bash \
    TERM=xterm-256color

# -----------------------------------------------
# Config: Toolbox filesystem
# -----------------------------------------------

ENV \
    TOOLBOX_ROOT=/opt/toolbox \
    TOOLBOX_CONFIG=/opt/toolbox/config \
    TOOLBOX_DATA=/opt/toolbox/share \
    TOOLBOX_STATE=/opt/toolbox/state \
    TOOLBOX_CACHE=/opt/toolbox/cache \
    TOOLBOX_BIN=/opt/toolbox/bin \
    TOOLBOX_RUNTIME_ROOT=/run/toolbox

# -----------------------------------------------
# Config: Node.js / npm
# -----------------------------------------------

ENV \
    NPM_CONFIG_CACHE=${TOOLBOX_CACHE}/npm \
    NPM_CONFIG_PYTHON=/usr/bin/python3

# -----------------------------------------------
# Config: Go
# -----------------------------------------------

ENV \
    GOPATH=${TOOLBOX_DATA}/go \
    GOBIN=${TOOLBOX_BIN} \
    GOCACHE=${TOOLBOX_CACHE}/go/build \
    GOMODCACHE=${TOOLBOX_CACHE}/go/modules

# GOTMPDIR is configured per runtime user by toolbox.sh.

# -----------------------------------------------
# Config: Rust
# -----------------------------------------------

ENV \
    CARGO_HOME=${TOOLBOX_DATA}/cargo \
    CARGO_TARGET_DIR=${TOOLBOX_CACHE}/cargo/target \
    RUSTUP_HOME=${TOOLBOX_DATA}/rustup

# -----------------------------------------------
# Config: uv
# -----------------------------------------------

ENV \
    UV_TOOL_DIR=${TOOLBOX_DATA}/uv/tools \
    UV_TOOL_BIN_DIR=${TOOLBOX_BIN} \
    UV_CACHE_DIR=${TOOLBOX_CACHE}/uv

# -----------------------------------------------
# Config: Liquidprompt
# -----------------------------------------------

ENV \
    LOCAL_RCFILE=${TOOLBOX_CONFIG}/liquidpromptrc \
    LIQUIDPROMPT_THEME=powerline

# -----------------------------------------------
# Config: OpenCode
# -----------------------------------------------

ENV \
    OPENCODE_CONFIG=${TOOLBOX_CONFIG}/opencode/opencode.json

# -----------------------------------------------
# Config: Git
# -----------------------------------------------

ENV \
    GIT_EDITOR=vi

# -----------------------------------------------
# Config: PATH
# -----------------------------------------------

ENV \
    PATH=${TOOLBOX_BIN}:${CARGO_HOME}/bin:${GOPATH}/bin:${PATH}

# =============================================================================
# : Postflight — common image
# =============================================================================

# Establish stable shared policy roots. Anything created normally below these
# directories inherits the shared group/default ACL.
RUN set -eux; \
    for directory in \
        "${TOOLBOX_ROOT}" \
        "${TOOLBOX_CONFIG}" \
        "${TOOLBOX_DATA}" \
        "${TOOLBOX_STATE}" \
        "${TOOLBOX_CACHE}" \
        "${TOOLBOX_BIN}"; \
    do \
        install -d \
            -o root \
            -g toolbox-shared \
            -m 2775 \
            "${directory}"; \
        setfacl \
            -m g:toolbox-shared:rwx \
            -m m::rwx \
            -m d:g:toolbox-shared:rwx \
            -m d:m::rwx \
            "${directory}"; \
    done; \
    \
    install -d \
        -o root \
        -g root \
        -m 0755 \
        "${TOOLBOX_RUNTIME_ROOT}"

# -----------------------------------------------
# Install shared tools
# -----------------------------------------------

ARG \
  NPM_OPENCODE_AI="" \
  NPM_NEOVIM=""

RUN set -eux; \
    umask 0002; \
    \
    export XDG_CONFIG_HOME="${TOOLBOX_CONFIG}"; \
    export XDG_DATA_HOME="${TOOLBOX_DATA}"; \
    export XDG_STATE_HOME="${TOOLBOX_STATE}"; \
    export XDG_CACHE_HOME="${TOOLBOX_CACHE}"; \
    \
    pipx install --global \
        uv${PIPX_UV:+==${PIPX_UV}}; \
    \
    if [ "${INSTALL_NODE_JS}" = "true" ]; then \
        npm install --global \
            opencode-ai${NPM_OPENCODE_AI:+@${NPM_OPENCODE_AI}} \
            neovim${NPM_NEOVIM:+@${NPM_NEOVIM}}; \
        npm cache clean --force; \
    fi; \
    \
    rustup default stable; \
    \
    cargo install \
        tree-sitter-cli \
        --locked \
        --root /usr/local \
        ${CARGO_TREE_SITTER_CLI:+--version=${CARGO_TREE_SITTER_CLI}}; \
    \
    python3 -m pip cache purge

# =============================================================================
# : Root filesystem overlay
# =============================================================================

# Do not use:
#
# COPY --chown=root:toolbox-shared rootfs/ /
#
# It can replace ownership and modes on existing system directories such as
# /usr, /etc and /opt.

# Root-owned executable files.
COPY \
    --chown=root:root \
    --chmod=0755 \
    rootfs/entrypoint.sh \
    /entrypoint.sh

COPY \
    --chown=root:root \
    --chmod=0755 \
    rootfs/usr/bin/toolbox.sh \
    /usr/bin/toolbox.sh

# Root-owned global Bash configuration.
COPY \
    --chown=root:root \
    rootfs/etc/bash.bashrc.d/ \
    /etc/bash.bashrc.d/

# Shared toolbox configuration.
COPY \
    --chown=root:toolbox-shared \
    rootfs/opt/toolbox/config/ \
    /opt/toolbox/config/

# Shared Neovim wrapper.
COPY \
    --chown=root:toolbox-shared \
    --chmod=0775 \
    rootfs/opt/toolbox/bin/vi \
    /opt/toolbox/bin/vi

# Normalize the two small copied trees. These remain inexpensive even when
# additional configuration fragments are introduced.
RUN set -eux; \
    \
    install -d \
        -o root \
        -g root \
        -m 0755 \
        /etc/bash.bashrc.d; \
    \
    find /etc/bash.bashrc.d \
        -xdev \
        -type d \
        -exec chown root:root {} + \
        -exec chmod 0755 {} +; \
    \
    find /etc/bash.bashrc.d \
        -xdev \
        -type f \
        -exec chown root:root {} + \
        -exec chmod 0644 {} +; \
    \
    install -d \
        -o root \
        -g toolbox-shared \
        -m 2775 \
        "${TOOLBOX_CONFIG}" \
        "${TOOLBOX_BIN}"; \
    \
    setfacl \
        -m g:toolbox-shared:rwx \
        -m m::rwx \
        -m d:g:toolbox-shared:rwx \
        -m d:m::rwx \
        "${TOOLBOX_CONFIG}" \
        "${TOOLBOX_BIN}"; \
    \
    find "${TOOLBOX_CONFIG}" \
        -xdev \
        -type d \
        -exec chgrp toolbox-shared {} + \
        -exec chmod 2775 {} + \
        -exec setfacl \
            -m g:toolbox-shared:rwx \
            -m m::rwx \
            -m d:g:toolbox-shared:rwx \
            -m d:m::rwx \
            {} +; \
    \
    find "${TOOLBOX_CONFIG}" \
        -xdev \
        -type f \
        -exec chgrp toolbox-shared {} + \
        -exec chmod g+rw {} +

# =============================================================================
# : Neovim builder
# =============================================================================

FROM toolbox-common AS nvim-builder

ARG INSTALL_NEOVIM="false"

# Only the exported application data root is named here. Lazy, Mason,
# Treesitter and other plugins manage their own descendants.
RUN set -eux; \
    install -d \
        -o root \
        -g toolbox-shared \
        -m 2775 \
        "${TOOLBOX_DATA}/nvim"; \
    \
    setfacl \
        -m g:toolbox-shared:rwx \
        -m m::rwx \
        -m d:g:toolbox-shared:rwx \
        -m d:m::rwx \
        "${TOOLBOX_DATA}/nvim"; \
    \
    umask 0002; \
    \
    if [ "${INSTALL_NEOVIM}" = "true" ]; then \
        "${TOOLBOX_BIN}/vi" \
            --headless \
            "+Lazy! sync" \
            +qa; \
        \
        "${TOOLBOX_BIN}/vi" \
            --headless \
            "+MasonToolsInstallSync" \
            +qa; \
    fi

# =============================================================================
# : Final image
# =============================================================================

FROM toolbox-common AS final

# This copy both exports and normalizes the potentially large Neovim tree.
COPY \
    --from=nvim-builder \
    --chown=root:toolbox-shared \
    --chmod=u=rwX,g=rwX,o=rX \
    /opt/toolbox/share/nvim/ \
    /opt/toolbox/share/nvim/

# Verify that system libraries remain accessible after dropping root.
RUN setpriv \
    --reuid=65534 \
    --regid=65534 \
    --clear-groups \
    /bin/bash -c ':'

# Mason staging is ephemeral runtime data and should not be inherited
# from the root-owned build process.
RUN set -eux; \
    install -d \
        -o root \
        -g toolbox-shared \
        -m 2775 \
        "${TOOLBOX_DATA}"; \
    \
    setfacl \
        -m g:toolbox-shared:rwx \
        -m m::rwx \
        -m d:g:toolbox-shared:rwx \
        -m d:m::rwx \
        "${TOOLBOX_DATA}" \
        "${TOOLBOX_DATA}"

WORKDIR /

ENTRYPOINT ["/entrypoint.sh"]
