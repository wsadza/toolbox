          && apt-get update \
          && apt-get install --no-install-recommends -y \
             curl \
             jq \
      && \
      echo "**** Installation ****" \
          && ARCHITECTURE="x86_64" \
          && API_URL="https://api.github.com/repos/nektos/act" \
          && RELEASE_URL="$( \
               curl -fsSL "${API_URL}/releases/latest" | \
                 jq -r \
